# Reusable Caddy honeypot decoy + bot-shield snippet for `gx` (and optional `g`).
# Requires `/etc/caddy/bans.caddy` (auto-generated `(ip_bans)` snippet by deployd shield)
# to be imported near the top of Caddyfile, plus `import bot_shield` inside site blocks.
(bot_shield) {
	import ip_bans
	@honeypot_path {
		path /wp-admin* /wp-login* /wp-content* /wp-includes* /xmlrpc.php /.env /.env.* /.git* /.svn* /.hg* /.DS_Store /cgi-bin/* /phpmyadmin* /pma* /actuator*
	}
	@honeypot_php {
		not {
			host fresh.xeed.ink fresh.gx.xihale.top
		}
		path *.php
	}
	@bad_ua {
		header_regexp User-Agent (?i)(nuclei|sqlmap|nikto|zgrab|masscan|nmap|dirbuster|gobuster|feroxbuster|wpscan|acunetix|nessus|openvas|fhscan|zmeu|libwww-perl|morfeus|python-httpx|semrushbot|ahrefsbot|mj12bot|dotbot|barkrowler|blexbot|dataforseobot|generalretrievalbot|elevenlabscrawler|bytespider|ccbot|gptbot|claudebot|anthropic-ai|perplexitybot|amazonbot|meta-externalagent|meta-webindexer)
	}
	route {
		header @honeypot_path Content-Type "text/plain; charset=utf-8"
		header @honeypot_path Cache-Control "no-store"
		respond @honeypot_path "CAONIMAGEBI=Fuck_You_Bitch" 200
		header @honeypot_php Content-Type "text/plain; charset=utf-8"
		header @honeypot_php Cache-Control "no-store"
		respond @honeypot_php "CAONIMAGEBI=Fuck_You_Bitch" 200
		respond @bad_ua 403
	}
}
