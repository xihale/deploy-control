# gx VPS deployd configuration TEMPLATE.
# Real config lives at /var/lib/deployd/config.yaml (0600 root) with real
# tokens/secrets — never commit those. Relative paths resolve against the
# config file's directory.
listen: 127.0.0.1:8795
db_path: deploy.db
state_dir: state
log_dir: state/logs
web_dir: web/out

global_concurrency: 2
deploy_timeout_sec: 3600   # zig compiler source-build fallback can be slow

fetch:
  # snirect SNI-rewrite proxy (root user service, 127.0.0.1:7654).
  # Attempt 1 always direct; HTTPS retries 2-5 via proxy; SSH remotes direct.
  proxy: http://127.0.0.1:7654

users:
  - name: xihale
    token_hash: <sha256 of admin token>
    role: admin
  - name: viewer
    token_hash: <sha256 of viewer token>
    role: viewer

sites:
  - name: blog
    repo: https://github.com/xihale/blog
    branch: astro
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <openssl rand -hex 20>
    run_as: blog-ci
  - name: zig-playground
    repo: https://github.com/xihale/zig-playground
    branch: master
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: zig-ci
  - name: poetry
    repo: https://github.com/xihale/poetry
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: poetry-ci
  - name: schedmate
    repo: https://github.com/xihale/schedmate
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: sched-ci
  - name: ziglings-web
    repo: https://github.com/xihale/ziglings-web
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: ziglings-ci
  - name: foyer
    repo: https://github.com/xihale/foyer
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: foyer-ci
  - name: me
    repo: git@github.com:xihale/me.git
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: me-ci
  - name: light-cathedral
    repo: https://github.com/xihale/light-cathedral.git
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: lc-ci
  - name: sonny-boy
    repo: git@github.com:xihale/sonny-boy.git
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: sonny-boy-ci
  # deploy-control itself (self-bootstrap); no run_as: runs as the service
  # user (root) because it installs the binary and restarts the service.
  - name: deploy-control
    repo: https://github.com/xihale/deploy-control
    branch: main
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
