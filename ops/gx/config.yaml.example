# gx VPS deployd configuration TEMPLATE.
# Real config lives at /var/lib/deployd/config.yaml (0600 root) with real
# tokens/secrets — never commit those. Relative paths resolve against the
# config file's directory.
listen: 127.0.0.1:8795
db_path: deploy.db
state_dir: state
log_dir: state/logs
web_dir: web/out

global_concurrency: 2
deploy_timeout_sec: 3600   # zig compiler source-build fallback can be slow

fetch:
  # snirect SNI-rewrite proxy (root user service, 127.0.0.1:7654).
  # Attempt 1 always direct; HTTPS retries 2-5 via proxy; SSH remotes direct.
  proxy: http://127.0.0.1:7654

analytics:
  enabled: true
  db_path: analytics.db
  caddy_logs:
    - /var/log/caddy/access.log
  timezone: Asia/Shanghai
  retention_days: 365
  ignore_bots: true
  exclude_paths: [/api/, /webhook/, /healthz]
  exclude_ips: ["127.0.0.1", "::1"]

users:
  - name: xihale
    token_hash: <sha256 of admin token>
    role: admin
  - name: viewer
    token_hash: <sha256 of viewer token>
    role: viewer

sites:
  - name: blog
    repo: https://github.com/xihale/blog
    branch: astro
    url: https://xeed.ink
    hosts: [www.xeed.ink]
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <openssl rand -hex 20>
    run_as: blog-ci
  - name: zig-playground
    repo: https://github.com/xihale/zig-playground
    branch: master
    url: https://zp.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: zig-ci
  - name: poetry
    repo: https://github.com/xihale/poetry
    branch: main
    url: https://poetry.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: poetry-ci
  - name: schedmate
    repo: https://github.com/xihale/schedmate
    branch: main
    url: https://sched.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: sched-ci
  - name: ziglings-web
    repo: https://github.com/xihale/ziglings-web
    branch: main
    url: https://zlg.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: ziglings-ci
  - name: foyer
    repo: https://github.com/xihale/foyer
    branch: main
    url: https://home.xeed.ink
    hosts: [status.xeed.ink]
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: foyer-ci
  - name: me
    repo: git@github.com:xihale/me.git
    branch: main
    url: https://me.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: me-ci
  - name: light-cathedral
    repo: https://github.com/xihale/light-cathedral.git
    branch: main
    url: https://lc.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: lc-ci
  - name: sonny-boy
    repo: git@github.com:xihale/sonny-boy.git
    branch: main
    url: https://sonny-boy.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: sonny-boy-ci
  - name: upix-web
    repo: https://github.com/xihale/upix.git
    branch: main
    url: https://upix.xeed.ink
    ref_regex: ^refs/tags/web-v[0-9]+\.[0-9]+\.[0-9]+$
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: upix-ci
  - name: mintcal
    repo: https://github.com/xihale/goke
    branch: main
    url: https://goke.xeed.ink
    events: [push, release]
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>
    run_as: mintcal-ci
  # deploy-control itself (self-bootstrap); no run_as: runs as the service
  # user (root) because it installs the binary and restarts the service.
  - name: deploy-control
    repo: https://github.com/xihale/deploy-control
    branch: main
    url: https://deploy.xeed.ink
    script: /var/lib/deployd/scripts/run-site
    webhook_secret: <secret>

analytics:
  enabled: true
  db_path: analytics.db
  caddy_logs: [/var/log/caddy/*.log]
  timezone: Asia/Shanghai
  retention_days: 365
  exclude_paths: [/api/, /healthz, /webhook/]
  exclude_ips: [127.0.0.1, "::1"]
  shield:
    enabled: true
    ban_ttl_hours: 168
    max_bans: 5000
    subnet_threshold: 5
    reload_cooldown_sec: 15
    caddy_ban_file: /etc/caddy/bans.caddy
    caddy_reload_cmd: [systemctl, reload, caddy]
    exclude_php_sites: [fresh]
